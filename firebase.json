{
  "hosting": {
    "public": "out",
    "ignore": ["**/.*"],
    "redirects": [
      {
        "source": "/admin",
        "destination": "https://gadget-doctor-east-kilbride.onrender.com/admin",
        "type": 302
      },
      {
        "source": "/admin/**",
        "destination": "https://gadget-doctor-east-kilbride.onrender.com/admin",
        "type": 302
      },
      {
        "source": "/superadmin",
        "destination": "https://gadget-doctor-east-kilbride.onrender.com/admin",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  }
}
