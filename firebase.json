{
  "hosting": {
    "public": "firebase-public",
    "ignore": ["**/.*"],
    "redirects": [
      {
        "source": "/",
        "destination": "https://gadget-doctor-east-kilbride.onrender.com/",
        "type": 302
      },
      {
        "source": "/:path*",
        "destination": "https://gadget-doctor-east-kilbride.onrender.com/:path",
        "type": 302
      }
    ]
  }
}
