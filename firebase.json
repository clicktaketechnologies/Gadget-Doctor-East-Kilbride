{
  "hosting": {
    "public": "out",
    "ignore": ["**/.*"],
    "redirects": [
      {
        "source": "/favicon.ico",
        "destination": "/gadget-doctor-logo.jpg",
        "type": 302
      },
      {
        "source": "/admin",
        "destination": "https://gadget-doctor-east-kilbride.onrender.com/admin",
        "type": 302
      },
      {
        "source": "/admin/**",
        "destination": "https://gadget-doctor-east-kilbride.onrender.com/admin",
        "type": 302
      },
      {
        "source": "/superadmin",
        "destination": "https://gadget-doctor-east-kilbride.onrender.com/admin",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/services",
        "destination": "/index.html"
      },
      {
        "source": "/services/**",
        "destination": "/index.html"
      },
      {
        "source": "/collection",
        "destination": "/index.html"
      },
      {
        "source": "/reviews",
        "destination": "/index.html"
      },
      {
        "source": "/blog",
        "destination": "/index.html"
      },
      {
        "source": "/blog/**",
        "destination": "/index.html"
      },
      {
        "source": "/contact",
        "destination": "/index.html"
      },
      {
        "source": "/track",
        "destination": "/index.html"
      },
      {
        "source": "/track/**",
        "destination": "/index.html"
      },
      {
        "source": "/service-detail",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
        ]
      },
      {
        "source": "/llms.txt",
        "headers": [
          { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
        ]
      },
      {
        "source": "/rss.xml",
        "headers": [
          { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json; charset=utf-8" }
        ]
      }
    ],
    "cleanUrls": true
  }
}
