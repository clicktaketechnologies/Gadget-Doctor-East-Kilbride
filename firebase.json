{
  "hosting": {
    "redirects": [
      {
        "source": "/**",
        "destination": "https://gadget-doctor-east-kilbride.onrender.com/**",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  }
}
