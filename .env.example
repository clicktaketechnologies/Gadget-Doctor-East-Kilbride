# Database URL — PostgreSQL (Supabase, Neon, Render Postgres, or self-hosted)
# Get this from your PostgreSQL provider's dashboard.
# Example (Supabase): postgresql://postgres:PASSWORD@db.XXXXX.supabase.co:5432/postgres
# Example (Neon):     postgresql://user:pass@host/dbname?schema=public
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ───────── Optional: SMTP email (for reply-to-customer feature) ─────────
# Configure these in the admin panel (Email module) OR set them here.
# When set here, they override the DB values.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_FROM_NAME=Gadget Doctor East Kilbride

# ───────── Next.js ─────────
# NextAuth secret (if you enable NextAuth later)
# NEXTAUTH_SECRET=replace-with-a-long-random-string
# NEXTAUTH_URL=http://localhost:3000

# ───────── Firebase Analytics (pre-configured for gadgetdoctorls project) ─────────
# These are public client-side values (Firebase config is not secret).
# Already wired with the gadgetdoctorls project defaults in src/lib/firebase.ts.
# Override here if you want to use a different Firebase project.
