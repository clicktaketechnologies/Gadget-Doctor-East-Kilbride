# Database URLs — PostgreSQL (Supabase)
#
# Supabase + Prisma best practice: use TWO connection strings.
#
# DATABASE_URL      → the POOLER (Session mode) for runtime queries.
#                     Uses IPv4 (works on Render/Vercel/etc.)
# DIRECT_DATABASE_URL → the DIRECT connection for Prisma migrations
#                       (prisma db push / migrate). Prisma needs a direct
#                       connection for schema changes (poolers don't support it).
#
# ⚠️ If the direct connection (db.XXXX.supabase.co:5432) can't be reached
#    from Render (IPv6 issue), run 'prisma db push' from your LOCAL machine
#    instead — your PC can reach the direct connection fine. Then the app
#    uses DATABASE_URL (pooler) at runtime, which works on Render.
#
# Both URLs from: Supabase dashboard → Connect → "ORMs" → Prisma
# (Supabase gives you both URLs in one place)

# POOLER (Session mode) — used by the app at runtime
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# DIRECT connection — used by Prisma for schema migrations only
DIRECT_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ───────── Optional: SMTP email (for reply-to-customer feature) ─────────
# Configure these in the admin panel (Email module) OR set them here.
# When set here, they override the DB values.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_FROM_NAME=Gadget Doctor East Kilbride

# ───────── Next.js ─────────
# NextAuth secret (if you enable NextAuth later)
# NEXTAUTH_SECRET=replace-with-a-long-random-string
# NEXTAUTH_URL=http://localhost:3000

# ───────── Firebase Analytics (pre-configured for gadgetdoctorls project) ─────────
# These are public client-side values (Firebase config is not secret).
# Already wired with the gadgetdoctorls project defaults in src/lib/firebase.ts.
# Override here if you want to use a different Firebase project.
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDIN10b4rZnk1hKdO45fHBsuSuaVgBCDEI
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gadgetdoctorls.firebaseapp.com
